orla, Turfan, Urumqi and Kara Sheher; died at Korla in 1877"}],"km2":905627,"c":[-89.621,-40.594],"polys":[[[[82.914,42.254],[82.994,42.262],[83.156,42.278],[83.274,42.318],[83.39,42.36],[83.552,42.374],[83.714,42.39],[83.84,42.37],[83.93,42.318],[83.982,42.23],[84.144,42.244],[84.306,42.258],[84.43,42.238],[84.52,42.184],[84.534,42.064],[84.478,41.876],[84.492,41.756],[84.508,41.636],[84.48,41.54],[84.45,41.448],[84.466,41.328],[84.516,41.24],[84.566,41.152],[84.654,41.098],[84.582,41.032],[84.596,40.912],[84.612,40.79],[84.698,40.736],[84.712,40.616],[84.684,40.522],[84.656,40.428],[84.67,40.306],[84.598,40.24],[84.612,40.118],[84.542,40.05],[84.556,39.93],[84.57,39.808],[84.5,39.742],[84.472,39.646],[84.442,39.552],[84.33,39.512],[84.26,39.444],[84.104,39.43],[84.034,39.364],[83.922,39.322],[83.852,39.254],[83.782,39.186],[83.712,39.118],[83.644,39.05],[83.66,38.928],[83.674,38.808],[83.688,38.686],[83.706,38.564],[83.72,38.442],[83.666,38.252],[83.696,38.008],[83.78,37.954],[83.862,37.902],[83.944,37.848],[84.028,37.794],[84.112,37.74],[84.194,37.686],[84.208,37.564],[84.222,37.44],[84.304,37.386],[84.316,37.264],[84.332,37.142],[84.222,37.1],[84.154,37.032],[84.044,36.992],[83.976,36.922],[83.99,36.8],[84.004,36.678],[84.018,36.556],[84.1,36.5],[84.146,36.412],[84.262,36.392],[84.342,36.338],[84.424,36.282],[84.504,36.226],[84.516,36.104],[84.53,35.982],[84.542,35.858],[84.702,35.748],[84.816,35.726],[84.93,35.706],[85.01,35.652],[85.088,35.596],[85.096,35.58],[85.482,35.58],[85.516,35.614],[85.55,35.648],[85.684,35.648],[85.718,35.682],[85.752,35.716],[85.786,35.75],[85.786,35.818],[85.82,35.852],[85.954,35.852],[85.988,35.886],[86.022,35.92],[86.09,35.92],[86.124,35.954],[86.156,35.988],[86.494,35.988],[86.528,36.022],[86.562,36.056],[86.596,36.09],[86.63,36.124],[86.764,36.124],[86.798,36.158],[86.832,36.192],[88.52,36.192],[88.552,36.158],[88.586,36.124],[89.06,36.124],[89.094,36.09],[89.126,36.056],[90.072,36.056],[90.106,36.022],[90.14,35.988],[90.544,35.