    "@fontsource/alegreya": "^5.3.0",
    "@fontsource/alegreya-sans": "^5.3.0",
    "@fontsource/alegreya-sans-sc": "^5.3.0",
    "@fontsource/amiri": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "d3": "^7.9.0",
    "d3-geo": "^3.1.1",
    "polygon-clipping": "^0.15.7",
    "topojson-client": "^3.1.0",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "playwright": "^1.48.0",
    "axe-core": "^4.10.0"
